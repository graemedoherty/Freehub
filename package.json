{
  "name": "freehub",
  "productName": "Freehub",
  "version": "1.0.0",
  "description": "Virtual cycling trainer app for the Zwift Hub",
  "main": "electron/main.js",
  "author": "Graeme Doherty",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.freehub.app",
    "productName": "Freehub",
    "files": ["server.js", "public/**/*", "electron/**/*", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "mac": {
      "category": "public.app-category.sports",
      "target": [ { "target": "dmg", "arch": ["arm64", "x64"] } ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Freehub connects to your trainer and heart-rate strap over Bluetooth.",
        "NSBluetoothPeripheralUsageDescription": "Freehub connects to your trainer and heart-rate strap over Bluetooth."
      },
      "notarize": true
    },
    "win": { "target": [ { "target": "nsis", "arch": ["x64"] } ], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
